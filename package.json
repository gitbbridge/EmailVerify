{
  "name": "emailverify",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "test:upload": "node --test tests/listImport.test.js tests/upload.permissions.test.js",
    "dev": "concurrently -k -n web,api -c blue,green \"npm:dev:web\" \"npm:dev:api\"",
    "dev:web": "vite --host 127.0.0.1",
    "dev:api": "nodemon server/index.js",
    "start": "node server/index.js",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "check": "npm run build",
    "test:team:db": "node --test tests/team.database.test.js",
    "test:auth:db": "node --test tests/auth.database.test.js",
    "test:auth:integration": "node --test tests/auth.integration.test.js",
    "test:browser": "playwright test",
    "db:team": "node scripts/apply-team-migration.js",
    "db:auth": "node scripts/apply-auth-recovery-migration.js",
    "db:batch-results": "node scripts/apply-batch-results-migration.js",
    "test:batches:db": "node --test tests/batches.database.test.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "Email verification SaaS shell and private provider proxy.",
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@supabase/supabase-js": "^2.116.0",
    "cors": "^2.8.6",
    "csv-parse": "^7.0.2",
    "dotenv": "^18.0.0",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "lucide-react": "^1.47.0",
    "multer": "^2.4.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "read-excel-file": "^9.3.10",
    "resend": "^6.28.1",
    "stripe": "^22.6.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.6.1",
    "concurrently": "^10.0.5",
    "nodemon": "^3.1.14",
    "pg": "^8.23.0",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.17",
    "vite": "^8.3.0",
    "write-excel-file": "^4.1.1"
  }
}
