# Server
PORT=8787
CLIENT_ORIGIN=http://127.0.0.1:5173

# Private upstream credentials. Never prefix these variables with VITE_.
EMAILABLE_API_KEY_TEST_KEY=test_replace_me
# EMAILABLE_API_KEY=live_replace_me
EMAILABLE_API_BASE_URL=https://api.emailable.com/v1

# Supabase. Keep the service role key server-only.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=replace_me
SUPABASE_SERVICE_ROLE_KEY=replace_me
DATABASE_URL=postgresql://replace_me

# Stripe
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# Resend
RESEND_API_KEY=re_replace_me
EMAIL_FROM=EmailVerify <notifications@example.com>
EMAIL_LOGO_URL=https://emailcheckr.xyz/images/logos/emailverify-wordmark.png
ADMIN_EMAIL=admin@example.com

# Used to irreversibly hash signup IPs before storage. Generate a long random value.
SIGNUP_FINGERPRINT_SECRET=replace_with_at_least_32_random_characters
